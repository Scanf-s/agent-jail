{
  "ociVersion": "1.3.0",
  "root": { "path": "rootfs", "readonly": false },
  "process": {
    "terminal": false,
    "user": { "uid": 0, "gid": 0 },
    "args": ["/bin/sh", "-c", "echo OCI_STARTED; pwd; id; env"],
    "env": ["PATH=/bin:/usr/bin", "HOME=/"],
    "cwd": "/tmp"
  },
  "mounts": [
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc",
      "options": ["nosuid", "nodev", "noexec"]
    }
  ],
  "linux": {
    "namespaces": [
      { "type": "user" },
      { "type": "pid" },
      { "type": "network" },
      { "type": "mount" },
      { "type": "cgroup" }
    ],
    "resources": {
      "cpu": { "quota": 100000, "period": 100000 },
      "memory": { "limit": 536870912 },
      "pids": { "limit": 64 }
    }
  }
}
